# =====================================================================
# PEQUENOS NA FÉ — VARIÁVEIS DE AMBIENTE (SERVIDOR E CLIENTE)
# Nunca envie valores reais para o repositório GitHub.
# Configure na Vercel (Project Settings -> Environment Variables) ou nos Segredos do projeto.
# =====================================================================

# --- CAKTO API (SERVIDOR - PRIVADAS) ---
# Painel Cakto -> Integrações -> Cakto API -> Criar Chave de API
# Escopos necessários: write payments, read orders (e write webhooks se criar via API)
CAKTO_API_CLIENT_ID=""
CAKTO_API_CLIENT_SECRET=""

# ID da oferta principal ativa (R$ 9,90) no Painel Cakto -> Produtos -> Ofertas
CAKTO_OFFER_ID=""

# Segredo retornado ao cadastrar o webhook na Cakto (usado na validação HMAC-SHA256)
CAKTO_WEBHOOK_SECRET=""

# Chave aleatória forte (64+ chars) para assinar tokens de acesso do /obrigado
CHECKOUT_SIGNING_SECRET=""

# Opcional: ativar autenticação 3D Secure no cartão ("true" ou "false")
CAKTO_ENABLE_3DS="false"

# Opcional: mapa JSON de ofertas combinadas quando Order Bumps forem ativados
# Exemplo: {"bump_a":"OFFER_ID_COMBO_A"}
CAKTO_COMBO_OFFERS_JSON=""

# --- CAKTO SDK (FRONTEND - PÚBLICA) ---
# client_id com escopo de tokenização de cartão (usado pelo cakto-sdk.min.js no navegador)
CAKTO_SDK_CLIENT_ID=""
VITE_CAKTO_SDK_CLIENT_ID=""

# --- ACESSO AO APLICATIVO (SERVIDOR) ---
# URL real de acesso do aplicativo Pequenos na Fé exibida após confirmação do pagamento
APP_ACCESS_URL=""

# --- META PIXEL & CONVERSIONS API (CAPI) ---
VITE_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
# Opcional: código de teste do Gerenciador de Eventos da Meta (remova em produção)
META_CAPI_TEST_EVENT_CODE=""

# --- LOWTRACK ---
# URL do script pixel.js fornecido no painel da LowTrack (ex: https://lowtrack.com.br/pixel.js?id=...)
VITE_LOWTRACK_PIXEL_URL=""
# Token da API de Webhook: Painel LowTrack -> Integrações -> API Tokens
LOWTRACK_API_TOKEN=""